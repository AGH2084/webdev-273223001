# Configuration names only. Never commit real credentials or print .env in agent chats.
# Required PostgreSQL connection URL: Neon Connect dialog; local tests use a disposable PostgreSQL server.
DATABASE_URL=postgresql://user:placeholder@localhost:5432/club_calendar
# Required in production: the public HTTPS origin, without a callback path.
PUBLIC_BASE_URL=http://localhost:3000
# Render supplies PORT. Locally defaults to 3000.
PORT=3000
# Render/Docker use production. Demo seeding is refused in production.
NODE_ENV=development
# Optional Google OAuth client from Google Cloud Console. Without both, password sign-in still works.
# Register PUBLIC_BASE_URL/api/auth/google/callback as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional Gemini key from AI Studio; absent key leaves manual entry available.
GEMINI_API_KEY=
MODEL_NAME=gemini-3.5-flash-lite
# Optional for the local MCP server: an ordinary unexpired session in the same database.
MCP_TOKEN=
# Tests only: disposable PostgreSQL. Never point this at Neon or a database containing real data.
TEST_DATABASE_URL=
